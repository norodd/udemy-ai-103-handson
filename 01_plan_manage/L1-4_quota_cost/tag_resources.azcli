# L1-4 実践(3/3): コスト按分のためのタグ付与 (Azure CLI / PowerShell) ※ README 手順8〜10 をまとめたもの（参考）
# タグは Cost Management でコストをプロジェクト/環境/コストセンター別に集計するための基本ツール。
# 事前に: az login 済み / 対象リソースに Contributor 以上 / 値は自分の環境に置き換える。
# ※ PowerShell 前提。1 行ずつ実行するのが分かりやすい。

# --- 変数 (自分の環境に合わせて変更) ---
$RG = "rg-udemy-ai-103-training"                             # 講座共通のリソースグループ
$FOUNDRY = az cognitiveservices account list --resource-group $RG --query "[?kind=='AIServices'] | [0].name" -o tsv

# 1) リソースグループにタグを付ける (merge = 既存タグを保持して追加)
#    ⚠️ az tag create は「全置換」で、既存タグが消える。使い回すリソースグループでは merge を使う。
az tag update `
  --resource-id (az group show --name $RG --query id -o tsv) `
  --operation merge `
  --tags project=ai103-course env=dev costcenter=training

# 2) Foundry リソース単体にタグを付ける
#    ⚠️ リソースは「リソースグループのタグを継承しない」。コスト集計に効かせるには
#       リソース自身にタグを付けるか、Cost Management の「タグ継承」設定を有効にする
#       (EA/MCA/MPA のみ。使用量レコードに適用され、反映は 8〜24 時間)。
$FOUNDRY_ID = az cognitiveservices account show -n $FOUNDRY -g $RG --query id -o tsv
az tag update --resource-id $FOUNDRY_ID --operation merge `
  --tags project=ai103-course env=dev costcenter=training

# 3) 付与結果を確認
az tag list --resource-id $FOUNDRY_ID -o jsonc

# --- 参考: Cost Management 側 ---
# Azure ポータル > Cost Management > Cost analysis で、
#   Group by = Tag「project」/ または Add filter で Tag=project を選ぶと
#   タグ別にコストを集計できる。
# ⚠️ すぐには出ない: タグ別のコストは「タグが付いていた期間の使用量」にだけ付き、
#    過去分に遡って適用されない。反映にも最大 24 時間かかる。
# Foundry プロジェクトには `project` タグが自動付与されるため、
#   プロジェクト単位の chargeback(プレビュー) は手動タグ無しでも可能。
#
# 予算アラート(通知のみ。自動遮断のハードリミットは無い):
# az consumption budget create `
#   --budget-name "ai103-monthly" --amount 50 --category cost `
#   --time-grain Monthly --resource-group $RG `
#   --start-date 2026-07-01 --end-date 2027-07-01
# ※ しきい値通知/Action Group の設定はポータルが分かりやすい。

# --- 後片付け (任意) ---
# 付けたタグだけ消す (リソースグループごとの削除はしない: 後続レッスンで使い回す)
# az tag update --resource-id $FOUNDRY_ID --operation delete --tags project=ai103-course
