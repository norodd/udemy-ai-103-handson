# L1-5 実践 (3/3): ロール割り当て ＋ local auth 無効化（キーレス化の仕上げ）※ README 手順6〜8・14〜16 と同じ内容（参考）
# ※ PowerShell (pwsh 7+) 前提。1 行ずつ実行するのが分かりやすい。
#    Windows / macOS / Linux / GitHub Codespaces のいずれでも同じコマンドで動く。
# ※ ロール割り当て・local auth 無効化には十分な権限（Owner / User Access Administrator 等）が必要。

# --- 変数 (自分の環境に合わせて変更) ---
# ⚠️ disableLocalAuth を変えるので、講座共通の rg-udemy-ai-103-training ではなく練習用の RG で行う（README 手順1〜5で作成）
$RG      = "rg-udemy-ai-103-training-l15"
$FOUNDRY = $ACCOUNT                        # Foundry(AIServices) リソース名（README 手順1の $ACCOUNT。
#   別のシェルで開き直したときは $FOUNDRY = 'ai103-l15-12345' のように単一引用符で名前を入れる）
$PROJECT = "ai103-l15-proj"               # プロジェクト名

# 自分のオブジェクトID / リソースID を取得
$MY_ID      = az ad signed-in-user show --query id -o tsv
$FOUNDRY_ID = az cognitiveservices account show -n $FOUNDRY -g $RG --query id -o tsv
$PROJECT_ID = "$FOUNDRY_ID/projects/$PROJECT"

# 0) まず「このリソースに対して、いま自分に何が効いているか」を見る
#    ⚠️ ロールは上位スコープから継承される。サブスクリプションやリソースグループに
#       Foundry User が付いていれば、リソース/プロジェクトには何も付けなくても推論できる。
#       「動かない」ときも「動く」ときも、まずここを見るのが切り分けの第一歩。
#    ※ --scope + --include-inherited が要点。このリソースに効いている割り当てだけが、
#       継承元（サブスクリプション / リソースグループ）も含めて並ぶ。
#       --all だと他のリソースグループの割り当てまで全部出てきて、肝心の継承関係が埋もれる。
az role assignment list --assignee $MY_ID --scope $FOUNDRY_ID --include-inherited `
  --query "[].{role:roleDefinitionName, scope:scope}" -o table

#    出力例（このリソースに Cognitive Services User がまだ無い状態）:
#      Role          Scope
#      ------------  ------------------------------------------------------
#      Owner         /subscriptions/<sub>
#      Foundry User  /subscriptions/<sub>
#      Foundry User  /subscriptions/<sub>/resourceGroups/<rg>
#    → Owner があっても推論はできない（コントロールプレーンのロールでデータアクションが無い）。
#      動いているのは Foundry User がサブスクリプション/リソースグループに付いているから。

# 1) データプレーン: プロジェクトに "Foundry User" を割り当て（main.py 用）
#    ※ Foundry 系ロールは改称のロールアウト中。名前ではなく GUID で指定するのが安全
#       (Foundry User = 53ca6127-db72-4b80-b1b0-d745d6d5456d)。
#    ※ Owner / Contributor では推論できない。データアクションを持つロールが必要。
az role assignment create `
  --role "53ca6127-db72-4b80-b1b0-d745d6d5456d" `
  --assignee-object-id $MY_ID --assignee-principal-type User `
  --scope $PROJECT_ID

# 2) 直接推論: Foundry リソースに "Cognitive Services User" を割り当て（keyless_openai_direct.py 用）
#    ※ Cognitive Services 系ロールは改称対象外なので名前指定でOK。
#    ※ "Cognitive Services OpenAI User" は OpenAI モデルだけに限定される点が試験の論点。
#       アカウントスコープの "Foundry User" でも同じデータアクションが入る。
az role assignment create `
  --role "Cognitive Services User" `
  --assignee-object-id $MY_ID --assignee-principal-type User `
  --scope $FOUNDRY_ID

# 3) 割り当て確認
#    ⚠️ 反映は即時ではない。公式ガイダンスは「最初の呼び出しまで5分以上待つ」。
az role assignment list --assignee $MY_ID --scope $FOUNDRY_ID --include-inherited --query "[].{role:roleDefinitionName, scope:scope}" -o table

# 4) 参考: トークンには「宛先(audience)」がある
#    同じ ID で取ったトークンでも、宛先(スコープ)が違えば通らない。
#    ARM 用トークン → 401 / Foundry 用トークン → 200 を並べて見ると、
#    「キーレスなのに 401」の正体が scope 違いだと一目で分かる。
$ARM_TOKEN = az account get-access-token --scope "https://management.azure.com/.default" --query accessToken -o tsv
$AI_TOKEN  = az account get-access-token --scope "https://ai.azure.com/.default" --query accessToken -o tsv

# ARM 用トークンで推論エンドポイントを叩く → 401
(Invoke-WebRequest -SkipHttpErrorCheck -Uri "https://$FOUNDRY.openai.azure.com/openai/v1/models" `
   -Headers @{ Authorization = "Bearer $ARM_TOKEN" }).StatusCode

# Foundry 用トークンで同じエンドポイントを叩く → 200
(Invoke-WebRequest -SkipHttpErrorCheck -Uri "https://$FOUNDRY.openai.azure.com/openai/v1/models" `
   -Headers @{ Authorization = "Bearer $AI_TOKEN" }).StatusCode

# 5) local auth(APIキー) を無効化 = キーレスを強制する（disableLocalAuth=true）
#    ⚠️ これ以降キー方式は 403 AuthenticationTypeDisabled になる（実測は即時。公式は「数分〜最大数時間」）。
#       全利用側が Entra ID 認証へ移行済みであることを確認してから実行!
az resource update --ids $FOUNDRY_ID --set properties.disableLocalAuth=true

#    確認: disableLocalAuth が true になっているか
az resource show --ids $FOUNDRY_ID --query "properties.disableLocalAuth"

#    （Az PowerShell モジュールを使う場合の同等操作。公式ドキュメントはこちらを案内している）
#    Set-AzCognitiveServicesAccount -ResourceGroupName $RG -Name $FOUNDRY -DisableLocalAuth $true
#
#    （組織全体に強制したい場合は Azure Policy
#      「Azure AI Services resources should have key access disabled (disable local authentication)」を適用）

# 6) キーを再生成して、いま手元にあるキーを失効させる
#    ※ disableLocalAuth はサービス側でキー認証を拒否する設定。これとは別に、
#      「配ってしまった/画面に映してしまったキー」を無効化する手段が再生成。
az cognitiveservices account keys regenerate -n $FOUNDRY -g $RG --key-name Key1
az cognitiveservices account keys regenerate -n $FOUNDRY -g $RG --key-name Key2

#    ⚠️ 5) で disableLocalAuth=true にした「あと」だと、この再生成は失敗する（2026-09-21 実測）:
#         (BadRequest) Failed to regenerate key. disableLocalAuth is set to be true
#       → 順序は「再生成が先、無効化があと」。
#       無効化したあとで再生成が要る（キーが漏れた等）ときは、いったん false に戻してから行う:
#         az resource update --ids $FOUNDRY_ID --set properties.disableLocalAuth=false
#         az cognitiveservices account keys regenerate -n $FOUNDRY -g $RG --key-name Key1   # Key2 も
#         az resource update --ids $FOUNDRY_ID --set properties.disableLocalAuth=true
#       ※ regenerate の出力には新しいキーが載る。画面に出したくないときは
#         --query "key1 | length(@)" -o tsv のように長さだけ取り出す。

# --- 後片付け ---
# README 手順17 と同じ。練習用 RG ごと削除して purge する（ロールの割り当て先・キーもリソースと一緒に無くなる）。
# $RG が講座共通の rg-udemy-ai-103-training ではないことを目で確かめてから実行する。
# $RG
# az group delete --name $RG --yes --no-wait
# （数分待って削除が終わったら）
# az cognitiveservices account list-deleted -o table
# az cognitiveservices account purge --name $FOUNDRY --resource-group $RG --location japaneast
