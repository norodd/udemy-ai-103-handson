# L1-3 実践: Bicep（IaC）で Foundry リソース＋プロジェクト＋モデルデプロイを一括作成する（PowerShell）。
#
# 同じ main.bicep を dev/stg/prod でパラメータだけ替えて適用すれば、環境差分を最小化できる。
# 実行方法: PowerShell で1コマンドずつ実行。継続行は行末のバッククォート ` で表す。
#
# 事前に `az login` 済み、かつ Bicep CLI が利用可能（az に同梱）であること。

$RG = "rg-udemy-ai-103-training-l13"             # 練習用（講座共通の rg-udemy-ai-103-training とは別。最後に丸ごと消す）
$LOCATION = "japaneast"
# ⚠️ $ACCOUNT はサブドメインになるので「全世界で一意」。下の値のままだと
#    CustomDomainInUse で弾かれる場合がある。末尾に自分用の英数字を足すこと。
$ACCOUNT = "ai103-l13-$(Get-Random -Minimum 10000 -Maximum 99999)"
$PROJECT = "ai103-l13-proj"
$DEPLOYMENT = "chat"

# 1) リソースグループ
az group create --name $RG --location $LOCATION

# 2) what-if（変更プレビュー）: 実際に何が作られる/変わるかを事前確認（CI/CD の PR 相当）
az deployment group what-if `
  --resource-group $RG `
  --template-file main.bicep `
  --parameters foundryName=$ACCOUNT projectName=$PROJECT `
               deploymentName=$DEPLOYMENT modelName=gpt-5.4-nano modelVersion=2026-03-17

# 3) 適用（apply）: 問題なければ実際にデプロイ
#   すでに同じ構成があるなら、what-if のとおり増えない（冪等）。
az deployment group create `
  --resource-group $RG `
  --template-file main.bicep `
  --parameters foundryName=$ACCOUNT projectName=$PROJECT `
               deploymentName=$DEPLOYMENT modelName=gpt-5.4-nano modelVersion=2026-03-17

# 4) 出力（エンドポイント・デプロイ名）を確認 → .env に転記
az deployment group show `
  --resource-group $RG `
  --name main `
  --query "properties.outputs" -o json

# 5) 作成されたリソース一覧
az resource list --resource-group $RG -o table

# 6) （任意）後片付け: リソースグループごと削除
#   Standard（従量）デプロイは「置いておくだけ」では課金されない（課金は呼び出したトークン分だけ）ため、
#   削除は任意。学習を続けるなら残して次のレクチャーで使い回してよい。
#   片付けたい場合のみ実行（--yes で確認プロンプトを省略、--no-wait でバックグラウンド削除）。
az group delete --name $RG --yes --no-wait
