# L1-3 実践: Azure CLI（PowerShell）でモデルデプロイを「コードで再現」する（IaC の前段／Bicep の代替）。
#
# 実行方法: PowerShell で1行（1コマンド）ずつ実行する。継続行は行末のバッククォート ` で表す。
#   VS Code の統合ターミナル（PowerShell）にコピペしてもよい。
#
# 認証はキーレス: 事前に `az login` 済みであること（APIキーは使わない）。

# --- 0) 変数（自分の値に置き換える）-------------------------------------------
$RG = "rg-udemy-ai-103-training-l13"             # 練習用（講座共通の rg-udemy-ai-103-training とは別。最後に丸ごと消す）
$ACCOUNT = "ai103-l13-$(Get-Random -Minimum 10000 -Maximum 99999)"          # Foundry リソース名。サブドメインになるので「全世界で一意・小文字」
                                      # ⚠️ 取得済みの名前だと CustomDomainInUse で弾かれる。末尾に自分用の英数字を足すこと
$LOCATION = "japaneast"
$PROJECT = "ai103-l13-proj"           # Foundry project 名
$DEPLOYMENT = "chat"                  # 呼び出しに使うデプロイ名（model パラメータに渡す名前）

# --- 1) リソースグループ -----------------------------------------------------
az group create --name $RG --location $LOCATION

# --- 2) Foundry リソース（親）を作成 -----------------------------------------
#   --kind AIServices … Foundry リソース
#   --allow-project-management … Foundry project を作れるようにする
az cognitiveservices account create `
  --name $ACCOUNT `
  --resource-group $RG `
  --kind AIServices `
  --sku s0 `
  --location $LOCATION `
  --custom-domain $ACCOUNT `
  --allow-project-management `
  --assign-identity

# （任意・推奨）キーレス強制: ローカルキー認証を無効化（Entra ID のみ許可）
#   az cognitiveservices account update には disableLocalAuth を直接設定するオプションが無い
#   （--api-properties は properties.apiProperties に入るだけで、キー認証は無効化されない）。
#   そのため汎用の az resource update で properties.disableLocalAuth を設定する。
#   （公式が一次手段として案内しているのは Azure PowerShell の
#     Set-AzCognitiveServicesAccount -DisableLocalAuth $true、または Bicep/ARM の disableLocalAuth。
#     az だけで完結させたい場合が下の書き方になる）
az resource update `
  --ids $(az cognitiveservices account show --name $ACCOUNT --resource-group $RG --query id -o tsv) `
  --set properties.disableLocalAuth=true

#   確認: true ならキー認証は無効（反映には数分〜数時間かかることがある）
az cognitiveservices account show `
  --name $ACCOUNT `
  --resource-group $RG `
  --query properties.disableLocalAuth -o tsv

# --- 3) Foundry project（子＝作業空間）を作成 --------------------------------
#   --name はアカウント（Foundry リソース）名、--project-name がプロジェクト名。
#   ⚠️ この出力の properties.endpoints の "AI Foundry API" が、.env の PROJECT_ENDPOINT に入れる値。
#      形式: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
az cognitiveservices account project create `
  --name $ACCOUNT `
  --resource-group $RG `
  --project-name $PROJECT `
  --location $LOCATION

#   あとから取り直す場合（PROJECT_ENDPOINT 用）
az cognitiveservices account project show `
  --name $ACCOUNT `
  --resource-group $RG `
  --project-name $PROJECT `
  --query 'properties.endpoints."AI Foundry API"' -o tsv

# --- 4) どのモデルが、どの SKU で使えるかを確認（モデル名/バージョンは揮発情報）---
#   出力の整形は az 組み込みの --query（JMESPath）を使う（jq などの外部ツール不要）。
az cognitiveservices account list-models `
  --name $ACCOUNT `
  --resource-group $RG `
  --query "[].{name:name, format:format, version:version, sku:skus[0].name}" -o table

# --- 5) モデルをデプロイ（デプロイ名を付ける）--------------------------------
#   --model-name/--model-version/--model-format は手順4で確認した値に置き換える。
#   --sku-name はデプロイタイプ（GlobalStandard 等）。
az cognitiveservices account deployment create `
  --name $ACCOUNT `
  --resource-group $RG `
  --deployment-name $DEPLOYMENT `
  --model-name gpt-5.4-nano `
  --model-version 2026-03-17 `
  --model-format OpenAI `
  --sku-name GlobalStandard `
  --sku-capacity 10

# --- 6) デプロイ完了の確認（"Succeeded" が返ればOK）--------------------------
az cognitiveservices account deployment show `
  --deployment-name $DEPLOYMENT `
  --name $ACCOUNT `
  --resource-group $RG `
  --query "properties.provisioningState" -o tsv

# --- 7) アカウント単位のエンドポイントを取得（参考）--------------------------
#   ⚠️ これは <resource>.cognitiveservices.azure.com 形式の「アカウント」エンドポイント。
#      .env の PROJECT_ENDPOINT には使えない（プロジェクト単位の値は手順3で取得する）。
az cognitiveservices account show `
  --name $ACCOUNT `
  --resource-group $RG `
  --query "properties.endpoint" -o tsv

# --- 参考) バージョン自動更新ポリシーの確認（CLI は「読み取り」のみ可）-------
#   更新は REST / Azure PowerShell / Foundry ポータルで行う（CLI では変更不可）。
az cognitiveservices account deployment show `
  --deployment-name $DEPLOYMENT `
  --name $ACCOUNT `
  --resource-group $RG `
  --query "properties.versionUpgradeOption" -o tsv

# --- 8) （任意）後片付け: リソースグループごと削除 --------------------------
#   Standard（従量）デプロイは「置いておくだけ」では課金されない（課金は呼び出したトークン分だけ）ため、
#   削除は任意。学習を続けるなら残して次のレクチャーで使い回してよい。
#   片付けたい場合のみ実行（--yes で確認プロンプトを省略、--no-wait でバックグラウンド削除）。
az group delete --name $RG --yes --no-wait
